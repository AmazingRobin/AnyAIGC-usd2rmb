{
  "manifest_version": 3,
  "name": "AnyAIGC 汇率助手",
  "version": "1.0.1",
  "description": "在 AnyAIGC 模型广场和使用日志页面，一键把美元价格按自定义汇率换算成人民币显示。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://anyaigc.ai/*",
        "https://www.anyaigc.ai/*"
      ],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AnyAIGC 汇率助手（在模型广场 / 使用日志页面切换币种）",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "anyaigc-usd2rmb@anyaigc.local",
      "strict_min_version": "115.0"
    }
  }
}
